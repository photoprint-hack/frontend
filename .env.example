# Frontend — адрес Backend API (включая префикс /api/v1).
# Для локального Backend: http://localhost:8000/api/v1. Пустое значение включает моки.
VITE_API_URL=https://backend-v8pa.onrender.com/api/v1

# Явно включить моки, даже если VITE_API_URL задан.
VITE_USE_MOCKS=false

# Задержка ответов мок-API в миллисекундах (для демонстрации состояний загрузки).
VITE_MOCK_LATENCY=260
